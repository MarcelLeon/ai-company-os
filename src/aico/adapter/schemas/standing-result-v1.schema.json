{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "result", "summary", "criteria", "stop_conditions", "gaps", "risks", "next_actions"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "result": {"type": "string", "enum": ["complete", "blocked"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "verdict", "evidence", "sources"],
        "properties": {
          "criterion_id": {"type": "string", "maxLength": 8, "pattern": "^A[1-9][0-9]*$"},
          "verdict": {"type": "string", "enum": ["met", "unmet"]},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 2000},
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "line"],
              "properties": {
                "path": {"type": "string", "minLength": 1, "maxLength": 512},
                "line": {"type": "integer", "minimum": 1, "maximum": 1000000}
              }
            }
          }
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stop_id", "observed"],
        "properties": {
          "stop_id": {"type": "string", "maxLength": 8, "pattern": "^S[1-9][0-9]*$"},
          "observed": {"type": "boolean", "const": true}
        }
      }
    },
    "gaps": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "risks": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "next_actions": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}
  }
}
