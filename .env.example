# Copy to .env, replace placeholders, then run: chmod 600 .env
# aico-service checks permissions, required key names, and placeholders without printing values;
# aico-phase1 loads the values at runtime.

AICO_CHANNEL=telegram
AICO_TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
AICO_CLAUDE_WORKING_DIRECTORY=/absolute/path/to/ai-company-os
AICO_ENABLE_CODEX_ADAPTER=true
AICO_PROJECT_CONFIG_PATH=config/projects.example.json
AICO_PERSONA_CONFIG_PATH=config/personas.example.json
# Full commit selected by the owner/CI review authority. `aico-recovery capture` rejects HEAD drift,
# dirty worktrees, and config bytes that do not match this revision.
AICO_REVIEWED_CONFIG_REVISION=replace-with-full-reviewed-git-commit

# Required IM control-plane bindings. Unknown senders and untrusted chats are silently dropped
# before command parsing, state access, audit mutation, or provider dispatch.
AICO_OWNER_SENDER_IDS=replace-with-your-telegram-user-id
AICO_TRUSTED_TARGET_IDS=replace-with-your-private-chat-id
# Foreground bootstrap only: set true with both bindings blank, send one message, copy the local
# sender/target log, then set false and fill both bindings. aico-service refuses to install if true.
AICO_INGRESS_DISCOVERY_LOG_IDENTITIES=false

# Optional install admission profile. `strict` makes runtime alerts, external liveness, current
# commissioning, scheduled recovery with disposable drill, and owner-bound standing autonomy mandatory before launchd install.
# The runtime enforces the same mode on every Telegram/Feishu restart; config drift fails before
# Channel/state construction. It only proves local machine configuration; it does not attest receiver/provider independence,
# off-device storage, real platform delivery, human reading, or commercial readiness.
AICO_ABSENCE_ADMISSION_MODE=optional
# In strict service mode, editing/replacing/deleting this file makes runtime configuration health
# FAILED until the owner re-runs doctor and explicitly restarts/reinstalls; AICO never hot-reloads it.
# Finalize the absolute checkout-external paths below before creating the receipt. `aico-commission`
# binds this file's metadata generation (never content/hash), reviewed Git config, receiver-signed
# dead-man envelope/payload/key identity, and earliest evidence/probe expiry. Each recommission uses
# new paths; no overwrite. The public key is not secret but must be owner-pinned and non-writable by others.
# AICO_COMMISSIONING_DEAD_MAN_EVIDENCE_PATH=/absolute/private/path/to/signed-dead-man-evidence.json
# AICO_COMMISSIONING_RECEIVER_PUBLIC_KEY_PATH=/absolute/private/path/to/receiver-public.pem
# AICO_COMMISSIONING_RECEIPT_PATH=/absolute/private/path/to/runtime-commissioning.json

# Durable local state for boss-absent recovery.
AICO_STATE_DB_PATH=.aico/state.db
# The runtime creates owner-only .checkpoint.json and .lock sidecars. Use `aico-audit backup` for a
# matching recovery point; never copy the live pair separately. Restore is manual, owner-fenced, and
# requires a pre-restore safety/quarantine artifact. Legacy logs need owner-reviewed seal.
AICO_AUDIT_LOG_PATH=.aico/audit.jsonl
# Memory uses the same owner-only ledger/checkpoint/lock posture. Legacy JSONL requires explicit
# `aico-memory seal`; use `aico-memory backup|verify-backup|drill-backup|restore` for recovery.
AICO_MEMORY_PATH=.aico/memory.jsonl
# `aico-recovery capture` binds state + audit + memory, reviewed config, and secret-free runtime
# reinjection requirements. Post-restore receipts never copy values/hashes; AI provider auth and
# receiver DB remain unresolved, so no output claims full DR.
# Optional scheduled core capture. Disabled by default. The directory must already exist, be an
# absolute owner-only real directory outside the checkout, and should be a mounted destination whose
# availability is independently monitored. AICO will not create a missing mount, attest encryption/
# off-device storage, or ever restore automatically. Automatic retention is a separate opt-in below.
AICO_RECOVERY_BACKUP_ENABLED=false
# AICO_RECOVERY_BACKUP_CHECKOUT_PATH=/absolute/path/to/ai-company-os
# AICO_RECOVERY_BACKUP_OUTPUT_DIR=/absolute/private/path/to/recovery-destination
# AICO_RECOVERY_BACKUP_INTERVAL_SECONDS=86400
# AICO_RECOVERY_BACKUP_MAX_AGE_SECONDS=172800
# Independently re-open and deep-verify the latest artifact/receipt pair. Runtime health fails if
# custody is stale, the pair disappears/drifts, permissions widen, or the destination identity changes.
# AICO_RECOVERY_CUSTODY_CHECK_INTERVAL_SECONDS=3600
# AICO_RECOVERY_CUSTODY_MAX_AGE_SECONDS=7200
# Destructive and disabled by default. When explicitly enabled, only old VERIFIED + custody VERIFIED
# scheduled pairs are eligible. The newest generations and minimum age are both preserved. A PRUNING
# intent is durable and will finish reconciling after restart even if this switch is later disabled.
AICO_RECOVERY_RETENTION_ENABLED=false
# AICO_RECOVERY_RETENTION_AFTER_SECONDS=2592000
# AICO_RECOVERY_RETENTION_MIN_GENERATIONS=7
# AICO_RECOVERY_RETENTION_CHECK_INTERVAL_SECONDS=21600
# AICO_RECOVERY_RETENTION_MAX_PRUNES_PER_RUN=2
# Optional disposable production-path drill. Disabled by default and never restores live state.
# Success proves local state/audit/memory materialization only; it is not full DR evidence.
AICO_RECOVERY_DRILL_ENABLED=false
# AICO_RECOVERY_DRILL_INTERVAL_SECONDS=604800
# AICO_RECOVERY_DRILL_MAX_AGE_SECONDS=1209600
# Optional existing absolute owner-only directory, isolated from checkout and backup destination.
# When unset, the drill uses an automatically removed private system temporary directory.
# AICO_RECOVERY_DRILL_WORKSPACE=/absolute/private/path/to/recovery-drill-workspace
AICO_LOG_PATH=logs/aico.log
AICO_APPROVAL_MAX_AGE_SECONDS=86400
AICO_RUNTIME_HEARTBEAT_PATH=.aico/runtime-heartbeat.json
AICO_RUNTIME_HEARTBEAT_INTERVAL_SECONDS=30
AICO_RUNTIME_HEALTH_CHECK_TIMEOUT_SECONDS=5

# Optional independent runtime incident webhook. Keep unset until the HTTPS receiver implements
# Idempotency-Key deduplication. AICO_STATE_DB_PATH is mandatory when this is enabled.
# AICO_RUNTIME_ALERT_WEBHOOK_URL=https://alerts.example.com/aico-runtime
# AICO_RUNTIME_ALERT_WEBHOOK_BEARER_TOKEN=replace-with-alert-webhook-token
# AICO_RUNTIME_ALERT_WEBHOOK_TIMEOUT_SECONDS=5

# Optional external dead-man liveness. Its URL must differ from the incident alert URL; when both
# transports use bearer tokens, those tokens must also differ. The independent receiver must be
# armed with the same safe runtime identity and TTL before enabling this. Pulses are ephemeral and
# are never added to the
# durable incident outbox. Disarm the receiver explicitly before a permanent uninstall; a normal
# runtime stop intentionally sends no disarm signal.
# AICO_RUNTIME_LIVENESS_ENABLED=true
# AICO_RUNTIME_LIVENESS_WEBHOOK_URL=https://receiver.example.com/v1/runtime-liveness/pulses
# AICO_RUNTIME_LIVENESS_WEBHOOK_BEARER_TOKEN=replace-with-receiver-pulse-token
# AICO_RUNTIME_LIVENESS_WEBHOOK_TIMEOUT_SECONDS=5
# AICO_RUNTIME_MONITOR_ID=owner-runtime
# AICO_RUNTIME_LIVENESS_INTERVAL_SECONDS=60
# AICO_RUNTIME_LIVENESS_TTL_SECONDS=300

# Optional scheduled handoff; requires AICO_STATE_DB_PATH for durable delivery evidence.
# The timeout covers only the IM platform acknowledgement, not human reading or standing autonomy.
AICO_MORNING_PUSH_ENABLED=false
AICO_MORNING_PUSH_TARGET_ID=replace-with-trusted-chat-id
AICO_MORNING_PUSH_PROJECT=aico
AICO_MORNING_PUSH_TIME=09:00
# AICO_MORNING_PUSH_DELIVERY_TIMEOUT_SECONDS=60

# Optional owner-bound read-only standing autonomy. The file must be chmod 600, owned by the
# runtime user, and stored outside every managed project repo. Do not point this at a sample file;
# creating or renewing a grant is an explicit owner operation.
# AICO_STANDING_AUTONOMY_GRANT_PATH=/absolute/private/path/standing-autonomy.json
