# Copy to .env on the independent receiver host. Never reuse either token.
AICO_DEAD_MAN_STATE_DB_PATH=/data/dead-man.db
# Generate an Ed25519 PKCS#8 key once on the receiver host; chmod 600 and back it up separately.
AICO_DEAD_MAN_EVIDENCE_SIGNING_PRIVATE_KEY_PATH=/signing/evidence-signing-private.pem
AICO_DEAD_MAN_PULSE_BEARER_TOKEN=replace-with-at-least-32-random-characters
AICO_DEAD_MAN_ADMIN_BEARER_TOKEN=replace-with-a-different-32-character-token
AICO_DEAD_MAN_NOTIFICATION_WEBHOOK_URL=https://owner-notify.example/runtime-outages
# AICO_DEAD_MAN_NOTIFICATION_BEARER_TOKEN=replace-with-owner-notify-token
# Optional independent fallback origin. Keep the token distinct from every receiver authority.
# AICO_DEAD_MAN_NOTIFICATION_FALLBACK_WEBHOOK_URL=https://fallback-notify.example/runtime-outages
# AICO_DEAD_MAN_NOTIFICATION_FALLBACK_BEARER_TOKEN=replace-with-fallback-notify-token
# 1 = availability-first failover; set 2 only when both route ACKs are required.
AICO_DEAD_MAN_NOTIFICATION_MINIMUM_ACKNOWLEDGEMENTS=1
AICO_DEAD_MAN_NOTIFICATION_TIMEOUT_SECONDS=5
# Keep disabled unless both real webhook bridges implement silent-route-probe-v1: ACK and suppress.
AICO_DEAD_MAN_NOTIFICATION_PROBE_CONTRACT=disabled
AICO_DEAD_MAN_NOTIFICATION_PROBE_INTERVAL_SECONDS=900
AICO_DEAD_MAN_NOTIFICATION_PROBE_FAILURE_THRESHOLD=2
AICO_DEAD_MAN_NOTIFICATION_PROBE_MAX_AGE_SECONDS=1800
AICO_DEAD_MAN_SWEEP_INTERVAL_SECONDS=15
AICO_DEAD_MAN_HOST=0.0.0.0
AICO_DEAD_MAN_PORT=8080
